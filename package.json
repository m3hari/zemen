{
  "name": "zemen",
  "version": "0.0.8",
  "description": "Ethiopian calender library",
  "author": "m3hari",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m3hari/zemen.git"
  },
  "homepage": "https://m3hari.github.io/zemen/",
  "bugs": "https://github.com/m3hari/zemen/issues",
  "keywords": [
    "date",
    "calender",
    "ethiopia"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENCE.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify": "bun scripts/verify.ts",
    "check": "bun run typecheck && bun test && bun run build",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
